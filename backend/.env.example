# Copy to backend/.env. Only GEMINI_API_KEY is needed for the full experience;
# without it the deterministic verdict still runs and LLM features are reported as off.
GEMINI_API_KEY=
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_TTS=gemini-3.8-flash-tts
GEMINI_MODEL_EMBED=gemini-embedding-2

# Base URL printed in the PDF's verify QR code. Set this to the deployed URL.
# Unset, the QR uses each request's own origin.
PUBLIC_WEB_URL=
# true only behind a proxy you control: X-Forwarded-* then decide the client IP and origin.
TRUST_PROXY=false

# Off by default: the verdict and its text are deterministic.
LLM_POLISH=false
LLM_PLANNER=false

# Optional
DATABASE_URL=
OPEN_METEO_API_KEY=
PC_SDK_SUBSCRIPTION_KEY=
# POST /api/jobs/tick is refused while this is empty. Generate with: openssl rand -hex 32
SCHEDULER_TOKEN=
